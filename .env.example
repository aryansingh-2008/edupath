# EduPath Environment Variables Template
# Copy this file to .env.local for local overrides

# Application Mode
NEXT_PUBLIC_ENABLE_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LLM Providers (Optional for live inference - Demo Mode works offline without keys)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Persistence (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edupath

# Supabase Auth / Storage (Optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
